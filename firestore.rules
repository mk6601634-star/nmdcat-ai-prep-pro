rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'mdcatquizbymehran@gmail.com';
    }

    function isUserCreate() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    function isUserRead() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isUserUpdate() {
      return isAuthenticated() &&
             resource.data.userId == request.auth.uid &&
             request.resource.data.userId == request.auth.uid;
    }

    function isUserDelete() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isAdminUser() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.status == 'Active')
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdminUser());
      allow create: if isAuthenticated() && request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if isAuthenticated() && request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /topics/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /examAttempts/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /savedMistakes/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /dailyTargets/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /userNotes/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /customMCQs/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /userFlashcards/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /userMindMaps/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /userMnemonics/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /userFormulas/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /userReactions/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /userDefinitions/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /aiQuizzes/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /userPrismSessions/{docId} {
      allow create: if isUserCreate();
      allow read: if isUserRead();
      allow update: if isUserUpdate();
      allow delete: if isUserDelete();
    }

    match /adminUsers/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdminUser());
      allow write: if isSuperAdmin();
    }

    match /mcqs/{docId} {
      allow read: if resource.data.status == 'PUBLISHED' || (isAuthenticated() && isAdminUser());
      allow write: if isAuthenticated() && isAdminUser();
    }

    match /notes/{docId} {
      allow read: if resource.data.status == 'PUBLISHED' || (isAuthenticated() && isAdminUser());
      allow write: if isAuthenticated() && isAdminUser();
    }

    match /flashcards/{docId} {
      allow read: if resource.data.status == 'PUBLISHED' || (isAuthenticated() && isAdminUser());
      allow write: if isAuthenticated() && isAdminUser();
    }

    match /formulas/{docId} {
      allow read: if resource.data.status == 'PUBLISHED' || (isAuthenticated() && isAdminUser());
      allow write: if isAuthenticated() && isAdminUser();
    }

    match /reactions/{docId} {
      allow read: if resource.data.status == 'PUBLISHED' || (isAuthenticated() && isAdminUser());
      allow write: if isAuthenticated() && isAdminUser();
    }

    match /mindMaps/{docId} {
      allow read: if resource.data.status == 'PUBLISHED' || (isAuthenticated() && isAdminUser());
      allow write: if isAuthenticated() && isAdminUser();
    }

    match /mnemonics/{docId} {
      allow read: if resource.data.status == 'PUBLISHED' || (isAuthenticated() && isAdminUser());
      allow write: if isAuthenticated() && isAdminUser();
    }

    match /vocab/{docId} {
      allow read: if resource.data.status == 'PUBLISHED' || (isAuthenticated() && isAdminUser());
      allow write: if isAuthenticated() && isAdminUser();
    }

    match /auditLogs/{docId} {
      allow read, write: if isAuthenticated() && isAdminUser();
    }

    match /reviewQueue/{docId} {
      allow read, write: if isAuthenticated() && isAdminUser();
    }

    match /contentVersions/{docId} {
      allow read, write: if isAuthenticated() && isAdminUser();
    }

    match /syllabusMappings/{docId} {
      allow read: if isAuthenticated() && (isAdminUser() || resource.data.status == 'ACTIVE' || resource.data.isPublic == true);
      allow write: if isAuthenticated() && isAdminUser();
    }

    match /backups/{docId} {
      allow read, write: if isAuthenticated() && isAdminUser();
    }

    match /importJobs/{docId} {
      allow read, write: if isAuthenticated() && isAdminUser();
    }
  }
}
