# SDK Library: @google/genai (Official Google Gen AI SDK)
# Model Name: gemini-3.6-flash
# Environment Variable Name: GEMINI_API_KEY
# Server Implementation: Handled securely server-side in server.ts to protect your secret key.
# AI Features Powered by Gemini in Your App:
#   - AI Medical Tutor & Doubt Resolver (/api/ai/chat)
#   - Automated MCQ & Material Generator/Extractor (/api/ai/extract-material)
#   - Diagnostic Test Generator (/api/ai/generate-diagnostic)
#   - Concept Explanations & Mnemonics Generator (/api/ai/explain)
# SECURITY NOTE: Replace YOUR_GEMINI_API_KEY with your actual API key from Google AI Studio.
# Never commit real API keys to version control. If a key was previously committed, it should be
# rotated immediately in the Google Cloud Console.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_MODEL: Optional model override if you want to set a specific Gemini version.
# Defaults to gemini-3.6-flash when not provided.
GEMINI_MODEL="gemini-3.6-flash"

# ============================================================
# FALLBACK AI PROVIDER (Groq Cloud API - Free Tier)
# ============================================================
# If primary Gemini hits free-tier quota (HTTP 429), the backend automatically
# fails over to Groq so user requests are never blocked.
FALLBACK_AI_ENABLED="true"
FALLBACK_AI_PROVIDER="groq"
FALLBACK_API_KEY="YOUR_FREE_GROQ_API_KEY"
FALLBACK_MODEL="groq/compound-mini"
FALLBACK_VISION_MODEL="llama-3.2-11b-vision-preview"


